rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════
//  VilleCabs Firestore Security Rules — HARDENED (pre-launch security review)
//
//  Key fixes vs previous version:
//   • promo_codes: users can no longer rewrite discounts/counters — redemption
//     is constrained to only touching usedBy/usageCount.
//   • bookings: update is now scoped to the ride's customer or a driver, not
//     "any signed-in user".
//   • notifications: read/create only; users can't overwrite or delete others'.
//   • tracking: only the ride's own customer can write its tracking doc.
//   • partnerRequests: no longer world-readable (contained business leads/PII).
//
//  Review in Firebase Console → Firestore → Rules before publishing, then:
//     firebase deploy --only firestore:rules
// ═══════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn() && request.auth.token.email in [
        'admin@villecabs.com'
      ];
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    // True only for an APPROVED driver. Note: every applicant gets a drivers/{uid}
    // doc at signup with status 'pending', so a mere exists() check would let
    // unapproved / rejected / suspended drivers claim rides via the API.
    // Any driver account, approved or not. Notices go to applicants as well —
    // "your documents are being reviewed" is exactly the kind of message a
    // PENDING driver needs, and isDriver() below would lock them out of it.
    function isDriverAccount() {
      return signedIn()
        && exists(/databases/$(database)/documents/drivers/$(request.auth.uid));
    }

    function isDriver() {
      return signedIn()
        && exists(/databases/$(database)/documents/drivers/$(request.auth.uid))
        && get(/databases/$(database)/documents/drivers/$(request.auth.uid)).data.status == 'approved';
    }

    // A customer is in good standing unless an admin has banned/suspended them.
    // NOTE: must use .data.get('status','') — a normal customer document has NO
    // status field at all, and reading a missing key throws, which Firestore
    // treats as DENY. That would block every ordinary booking.
    function isCustomerInGoodStanding() {
      return signedIn()
        && (!exists(/databases/$(database)/documents/customers/$(request.auth.uid))
            || !(get(/databases/$(database)/documents/customers/$(request.auth.uid)).data.get('status', '') in ['banned','suspended','deactivated']));
    }
    // Only the listed fields are being changed (everything else unchanged)
    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // ── Customers ────────────────────────────────────────────────────────────
    match /customers/{uid} {
      allow read:  if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid);
      // Owner may edit own profile but NOT their own 'status' (blacklist flag);
      // only admins can change status.
      allow update: if isAdmin()
                    || (isOwner(uid) && request.resource.data.status == resource.data.status)
                    || (isOwner(uid) && !('status' in resource.data) && request.resource.data.status == 'active')
                    || (isOwner(uid) && !('status' in request.resource.data));
      allow delete: if isAdmin();
    }

    // ── Drivers ──────────────────────────────────────────────────────────────
    // Driver docs hold private data (TRN, DOB, document URLs), so reads are
    // restricted to: the driver themselves, admins, or — for the customer-side
    // availability check — drivers that are approved AND currently online.
    // (The customer's live-ride screen no longer reads this collection at all;
    //  it uses the driver fields copied onto the booking at accept time.)
    // Queries MUST be filtered by status=='approved' && isOnline==true to pass.
    match /drivers/{uid} {
      allow read:   if isAdmin()
                    || isOwner(uid)
                    || (signedIn()
                        && resource.data.status == 'approved'
                        && resource.data.isOnline == true);
      allow create: if isOwner(uid);
      // A driver may edit their own profile, but must NOT change their own
      // status, and must NOT set isOnline unless they are approved — otherwise
      // a pending applicant shows up as an available driver.
      allow update: if isAdmin()
                    || (isOwner(uid)
                        && (!('status' in request.resource.data)
                            || request.resource.data.status == resource.data.status)
                        && (request.resource.data.get('isOnline', false) == false
                            || resource.data.get('status', '') == 'approved'));
      allow delete: if isAdmin();
    }

    // ── Bookings ─────────────────────────────────────────────────────────────
    // Read: any signed-in user (drivers must see open requests — the pragmatic
    //       rides-app pattern; tighten later with Cloud Functions if desired).
    // Create: only the customer creating their own booking.
    // Update: allowed for
    //   • admin
    //   • the ride's own customer (confirm / cancel)
    //   • a driver CLAIMING a ride that is still 'searching' and unassigned
    //     (this, combined with the client transaction, prevents two drivers
    //      from taking the same ride), or
    //   • the driver already assigned to this ride (arrive / complete / location)
    // Delete: admin only.
    match /bookings/{bookingId} {
      // Read: admin, the ride's customer, the assigned driver, or an approved
      // driver looking at OPEN rides (searching / scheduled). This stops any
      // signed-in user from enumerating every booking (and every rider's phone).
      // Client queries must be scoped by customerId, driverId, or status.
      allow read:   if isAdmin()
                    || (signedIn() && resource.data.customerId == request.auth.uid)
                    || (signedIn() && resource.data.driverId == request.auth.uid)
                    || (isDriver() && resource.data.status == 'searching')
                    || (isDriver() && resource.data.status == 'scheduled');
      allow create: if (signedIn()
                        && request.resource.data.customerId == request.auth.uid
                        && isCustomerInGoodStanding())
                    // CHARTER TRIP: an approved driver starts a day of a charter
                    // they have been assigned. They create the trip for someone
                    // else's charter, so the customer-owns-it check can't apply —
                    // instead it must be flagged as a charter and assigned to
                    // themselves, and they must own the parent charter.
                    || (isDriver()
                        && request.resource.data.get('isCharter', false) == true
                        && request.resource.data.driverId == request.auth.uid
                        && request.resource.data.status == 'active'
                        && exists(/databases/$(database)/documents/charterRequests/$(request.resource.data.charterId))
                        && get(/databases/$(database)/documents/charterRequests/$(request.resource.data.charterId)).data.assignedDriverId == request.auth.uid);
      allow update: if isAdmin()
                    || (signedIn() && resource.data.customerId == request.auth.uid)
                    // the driver already assigned to this ride may keep updating it
                    // (arrive / complete / location). No isDriver() get() here —
                    // this is the hot path (location writes every few seconds) and
                    // they were already verified as approved when they claimed it.
                    || (signedIn() && resource.data.driverId == request.auth.uid)
                    // any APPROVED driver may DECLINE an open ride — this only
                    // appends their uid to declinedBy, nothing else may change
                    || (isDriver() && onlyChanges(['declinedBy']))
                    // APPROVED driver claiming an OPEN ride: it must currently be
                    // searching (on-demand) or scheduled, and unassigned, and
                    // they must be assigning it to themselves
                    || (isDriver()
                        && (resource.data.status == 'searching' || resource.data.status == 'scheduled')
                        && (!('driverId' in resource.data) || resource.data.driverId == null)
                        && request.resource.data.driverId == request.auth.uid);
      allow delete: if isAdmin();

      // In-ride chat messages — participants send/read; recipient marks read
      // (adds uid to readBy). Delete is admin-only.
      // Only the ride's own customer and assigned driver (or an admin) may see
      // or send messages. Previously ANY signed-in user could read every chat.
      match /messages/{msgId} {
        function ride() {
          return get(/databases/$(database)/documents/bookings/$(bookingId)).data;
        }
        function isParticipant() {
          return signedIn()
            && (ride().get('customerId', '') == request.auth.uid
                || ride().get('driverId', '') == request.auth.uid);
        }
        allow read:   if isAdmin() || isParticipant();
        allow create: if isAdmin()
                      || (isParticipant() && request.resource.data.senderId == request.auth.uid);
        // A participant may only add themselves to readBy.
        allow update: if isAdmin()
                      || (isParticipant()
                          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']));
        allow delete: if isAdmin();
      }
    }

    // ── Payouts (driver payout tracking) ─────────────────────────────────────
    match /payouts/{payoutId} {
      allow read:   if isAdmin()
                    || (signedIn() && resource.data.driverId == request.auth.uid);
      allow create: if signedIn()
                    && request.resource.data.driverId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ── Settings (surge pricing + ride-request pause toggle) ─────────────────
    match /settings/{docId} {
      allow read:  if signedIn();
      allow write: if isAdmin();
    }

    // ── Partner / advertiser requests ────────────────────────────────────────
    // Anyone (incl. signed-out visitors) may SUBMIT the public form, BUT a
    // public submission must be status:'new' with NO slot — this stops a
    // malicious submitter from self-approving or planting their own ad in a
    // featured slot. Only admins can approve, assign slots, or change anything.
    // Public READ is allowed only for APPROVED / FEATURED partners (shown on the
    // dashboard). Pending / rejected leads (names, emails, phones) stay admin-only.
    match /partnerRequests/{id} {
      allow create: if request.resource.data.status == 'new'
                    && !('slot' in request.resource.data);
      allow read: if isAdmin()
                  || resource.data.status in ['approved', 'featured'];
      allow update, delete: if isAdmin();
    }

    // ── Reviews (rider reviews of drivers) ───────────────────────────────────
    match /reviews/{id} {
      allow read:   if signedIn();
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    // ── Service reviews (public "rate VilleCabs" wall) ───────────────────────
    // Publicly READABLE (the wall is shown to everyone, signed-out included) and
    // anyone may POST a review. Admins moderate (edit/delete). A posted review
    // must include a 1–5 rating and a non-empty comment.
    match /service_reviews/{id} {
      allow read:   if true;
      allow create: if request.resource.data.rating is int
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5
                    && request.resource.data.comment is string
                    && request.resource.data.comment.size() > 0
                    && request.resource.data.comment.size() <= 500;
      allow update, delete: if isAdmin();
    }

    // ── Public live-tracking (shared ride links) ─────────────────────────────
    // World-READABLE so a friend with the link can watch without an account.
    // Only the ride's own customer may create/update its tracking doc (the doc
    // id is the booking id, so we verify ownership of that booking).
    match /tracking/{bookingId} {
      allow read: if true;
      allow create, update: if signedIn()
        && get(/databases/$(database)/documents/bookings/$(bookingId)).data.customerId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // ── Promo codes ──────────────────────────────────────────────────────────
    // Publicly READABLE — promo codes are meant to be advertised (shown on the
    // landing page to signed-out visitors too). On redemption a signed-in
    // customer may ONLY append to usedBy / bump usageCount — they cannot change
    // the discount or reset limits. Only admins create/delete.
    match /promo_codes/{id} {
      allow read:   if true;
      allow update: if signedIn()
                    && onlyChanges(['usedBy', 'usageCount']);
      allow create, delete: if isAdmin();
    }

    // ── Notifications ────────────────────────────────────────────────────────
    // Any signed-in user may read and create a notification, but cannot edit or
    // delete existing ones (prevents tampering/spoofing). Admins manage.
    match /notifications/{id} {
      allow read:   if signedIn();
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    // ── Unfulfilled ride requests ────────────────────────────────────────────
    match /unfulfilled_ride_requests/{id} {
      allow create: if signedIn();
      allow read, update, delete: if isAdmin();
    }

    // ── Contact form submissions (public create, admin-read) ─────────────────
    match /contact_submissions/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ── App config (global force-logout cutoff, etc.) ────────────────────────
    // Any signed-in client reads it on session restore; only admin writes it.
    // ── DRIVER NOTICES — admin messages shown in the driver app ──────────────
    //  audience 'all'    → every driver
    //  audience 'driver' → only the driver named in driverId
    //  A driver cannot read a notice addressed to someone else. Firestore has no
    //  OR across a single query, so the app runs two queries (all / mine) and
    //  merges them; both are covered by the read rule below.
    match /driver_notices/{id} {
      allow read: if isAdmin()
                  || (isDriverAccount()
                      && (resource.data.get('audience','all') == 'all'
                          || resource.data.get('driverId','') == request.auth.uid));
      allow create, delete: if isAdmin();
      // A driver may ONLY mark it read — that means touching readBy and nothing
      // else, and only ever adding themselves. hasAll() stops them clearing
      // anyone else's read receipt; the uid check stops them marking it for
      // another driver. The message itself is immutable to them.
      allow update: if isAdmin()
                    || (isDriverAccount()
                        // ...and only on a notice actually addressed to them, so a
                        // driver cannot pad the read receipts on someone else's message.
                        && (resource.data.get('audience','all') == 'all'
                            || resource.data.get('driverId','') == request.auth.uid)
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
                        && request.resource.data.readBy.hasAll(resource.data.get('readBy', []))
                        && request.auth.uid in request.resource.data.readBy);
    }

    match /config/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /contactMessages/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ── Charter requests ─────────────────────────────────────────────────────
    // Anyone can submit a charter request (the form is open to guests too).
    // Only the admin reads/manages them.
    match /charterRequests/{id} {
      allow create: if request.resource.data.status == 'pending';

      // Approved drivers may see NEW unclaimed charter requests (so they can
      // take one), plus any charter already assigned to them. Everything else
      // stays admin-only.
      allow read: if isAdmin()
                  || (signedIn() && resource.data.get('assignedDriverId', null) == request.auth.uid)
                  || (isDriver() && resource.data.get('status','') == 'pending'
                      && resource.data.get('assignedDriverId', null) == null);

      allow update: if isAdmin()
                    // CLAIM: an approved driver takes an unassigned new charter
                    // request. Must be claiming it for themselves.
                    || (isDriver()
                        && resource.data.get('status','') == 'pending'
                        && resource.data.get('assignedDriverId', null) == null
                        && request.resource.data.assignedDriverId == request.auth.uid
                        && onlyChanges(['assignedDriverId','assignedDriverName','status','claimedAt','updatedAt']))
                    // PROGRESS: the assigned driver updates only the job status.
                    || (signedIn()
                        && resource.data.get('assignedDriverId', null) == request.auth.uid
                        && onlyChanges(['status','driverStartedAt','driverCompletedAt','updatedAt']));

      allow delete: if isAdmin();
    }

    // ── SOS / emergency alerts ───────────────────────────────────────────────
    match /sos_alerts/{id} {
      allow create: if signedIn();
      allow read, update, delete: if isAdmin();
    }
    match /sosAlerts/{id} {
      allow create: if signedIn();
      allow read, update, delete: if isAdmin();
    }


    // ═════════════════════════════════════════════════════════════════════════
    //  VILLEDASH
    //  Prices, statuses, rider assignment and PINs are written ONLY by Cloud
    //  Functions (functions/dash). Clients may read their own records and do a
    //  few harmless writes (rider sign-up, online toggle, live location).
    // ═════════════════════════════════════════════════════════════════════════
    function isRider() {
      return signedIn()
        && exists(/databases/$(database)/documents/riders/$(request.auth.uid))
        && get(/databases/$(database)/documents/riders/$(request.auth.uid)).data.status == 'approved';
    }

    // ── Deliveries ──────────────────────────────────────────────────────────
    //  Customer: their own. Rider: the one assigned to them, plus OPEN jobs
    //  (status 'requested') so they can accept one. Admin: all.
    //  No client writes at all.
    match /dash_deliveries/{id} {
      allow read: if isAdmin()
                  || (signedIn() && resource.data.customerId == request.auth.uid)
                  || (signedIn() && resource.data.riderId == request.auth.uid)
                  || (isRider() && resource.data.status == 'requested');
      allow write: if false;

      match /events/{eventId} {
        allow read: if isAdmin()
                    || (signedIn() && get(/databases/$(database)/documents/dash_deliveries/$(id)).data.customerId == request.auth.uid)
                    || (signedIn() && get(/databases/$(database)/documents/dash_deliveries/$(id)).data.riderId == request.auth.uid);
        allow write: if false;
      }
      // Phone numbers: the customer, the ASSIGNED rider and admins only.
      match /private/{docId} {
        allow read: if isAdmin()
                    || (signedIn() && get(/databases/$(database)/documents/dash_deliveries/$(id)).data.customerId == request.auth.uid)
                    || (signedIn() && get(/databases/$(database)/documents/dash_deliveries/$(id)).data.riderId == request.auth.uid);
        allow write: if false;
      }
      // The drop-off PIN — the customer shares it with the recipient. Riders
      // must never see it, so not even the assigned rider can read this.
      match /customer/{docId} {
        allow read: if isAdmin()
                    || (signedIn() && get(/databases/$(database)/documents/dash_deliveries/$(id)).data.customerId == request.auth.uid);
        allow write: if false;
      }
    }

    // PIN hashes — server only.
    match /dash_secrets/{id} {
      allow read, write: if false;
    }

    // Live rider position for a delivery. Only the assigned rider writes it,
    // only while the job is active; customer, rider and admin read it.
    match /dash_locations/{id} {
      function job() { return get(/databases/$(database)/documents/dash_deliveries/$(id)).data; }
      allow read: if isAdmin()
                  || (signedIn() && (job().customerId == request.auth.uid || job().riderId == request.auth.uid));
      allow create, update: if signedIn()
                  && job().riderId == request.auth.uid
                  && job().status in ['assigned','to_pickup','at_pickup','collected','to_dropoff','at_dropoff']
                  && request.resource.data.keys().hasOnly(['lat','lng','heading','accuracy','at','riderId'])
                  && request.resource.data.riderId == request.auth.uid
                  && request.resource.data.lat is number && request.resource.data.lng is number;
      allow delete: if isAdmin();
    }

    // ── Riders ──────────────────────────────────────────────────────────────
    //  A rider creates their own application as 'pending'. They can edit their
    //  profile and go online/offline (only once approved) but can never change
    //  their status, active job, motorcycle or earnings counters.
    match /riders/{uid} {
      allow read: if isAdmin() || isOwner(uid);
      allow create: if isOwner(uid)
                    && request.resource.data.status == 'pending'
                    && request.resource.data.get('isOnline', false) == false
                    && request.resource.data.get('backgroundCheck', 'not_started') == 'not_started'
                    && !('activeDeliveryId' in request.resource.data)
                    && !('motorcycleId' in request.resource.data)
                    && !('motorcyclePlate' in request.resource.data)
                    && !('completedCount' in request.resource.data)
                    && !('approvedAt' in request.resource.data);
      allow update: if isAdmin()
                    || (isOwner(uid)
                        && !request.resource.data.diff(resource.data).affectedKeys()
                             .hasAny(['status','activeDeliveryId','motorcycleId','motorcyclePlate','completedCount','approvedAt','approvedBy','onlineSince','backgroundCheck'])
                        && (request.resource.data.get('isOnline', false) == false
                            || resource.data.get('status','') == 'approved'));
      allow delete: if isAdmin();
    }

    // ── Pricing (admin-set, everyone signed in may read for display) ────────
    match /dash_pricing/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ── Analytics, money, support, audit — server writes, admin reads ───────
    match /dash_demand_events/{id} { allow read: if isAdmin(); allow write: if false; }
    match /ledger_entries/{id}     { allow read: if isAdmin(); allow update: if isAdmin(); allow create, delete: if false; }
    match /audit_logs/{id}         { allow read: if isAdmin(); allow write: if false; }
    match /support_cases/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.reporterId == request.auth.uid);
      allow update: if isAdmin();
      allow create, delete: if false;
      match /notes/{noteId} { allow read, create: if isAdmin(); allow update, delete: if false; }
    }


    // ── Marketplace ─────────────────────────────────────────────────────────
    //  merchants/{ownerUid}: one store per owner login. The public sees
    //  approved stores only. Owners edit their profile, hours and products, but
    //  never their own status or commission. Orders and settlements are
    //  written only by Cloud Functions.
    match /merchants/{uid} {
      allow read: if isAdmin() || isOwner(uid) || resource.data.status == 'approved';
      allow create: if isOwner(uid)
                    && request.resource.data.status == 'pending'
                    && !('commissionPct' in request.resource.data)
                    && !('approvedAt' in request.resource.data)
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 1;
      allow update: if isAdmin()
                    || (isOwner(uid)
                        && !request.resource.data.diff(resource.data).affectedKeys()
                             .hasAny(['status','commissionPct','approvedAt','approvedBy']));
      allow delete: if isAdmin();

      match /products/{productId} {
        allow read: if isAdmin() || isOwner(uid)
                    || get(/databases/$(database)/documents/merchants/$(uid)).data.status == 'approved';
        allow create, update: if (isAdmin() || isOwner(uid))
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.priceCents is int
                    && request.resource.data.priceCents >= 0
                    && (!('stock' in request.resource.data) || request.resource.data.stock == null
                        || (request.resource.data.stock is int && request.resource.data.stock >= 0));
        allow delete: if isAdmin() || isOwner(uid);
      }
    }

    match /dash_orders/{id} {
      allow read: if isAdmin()
                  || (signedIn() && resource.data.customerId == request.auth.uid)
                  || (signedIn() && resource.data.merchantId == request.auth.uid);
      allow write: if false;
      match /customer/{docId} {
        allow read: if isAdmin()
                    || (signedIn() && get(/databases/$(database)/documents/dash_orders/$(id)).data.customerId == request.auth.uid);
        allow write: if false;
      }
    }

    match /settlements/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.merchantId == request.auth.uid);
      allow write: if false;
    }

    // ── Fleet (admin only; riders never see provider details) ───────────────
    match /fleet_motorcycles/{id} {
      allow read, write: if isAdmin();
      match /log/{logId} { allow read, write: if isAdmin(); }
    }
    match /fleet_providers/{id}   { allow read, write: if isAdmin(); }

    // ── Rider shifts ────────────────────────────────────────────────────────
    //  Admin plans shifts. A rider can only confirm or decline their own
    //  scheduled shift — never move it, and never mark it completed.
    match /rider_shifts/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.riderId == request.auth.uid);
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
                    || (signedIn()
                        && resource.data.riderId == request.auth.uid
                        && resource.data.status in ['scheduled', 'confirmed']
                        && request.resource.data.status in ['confirmed', 'declined']
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt', 'declineReason']));
    }
    match /rider_time_off/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.riderId == request.auth.uid);
      allow create: if signedIn()
                    && request.resource.data.riderId == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.date is string;
      allow update: if isAdmin();
      allow delete: if isAdmin() || (signedIn() && resource.data.riderId == request.auth.uid && resource.data.status == 'pending');
    }
    match /rider_availability/{uid} {
      allow read: if isAdmin() || isOwner(uid);
      allow write: if isOwner(uid) || isAdmin();
    }
    match /rider_online_sessions/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.riderId == request.auth.uid);
      allow write: if false;
    }

    // ── VILLE cross-site house ads (public read, admin write) ───────────────
    match /site_ads/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // "Notify me" sign-ups from the VilleDash landing page before launch.
    match /dash_interest/{id} {
      allow create: if request.resource.data.keys().hasOnly(['contact', 'kind', 'source', 'createdAt'])
                    && request.resource.data.contact is string
                    && request.resource.data.contact.size() > 4
                    && request.resource.data.contact.size() <= 120
                    && request.resource.data.kind in ['email', 'phone']
                    && request.resource.data.source is string
                    && request.resource.data.source.size() <= 80
                    && request.resource.data.createdAt == request.time;
      allow read, delete: if isAdmin();
    }

    // ── Default deny for anything not explicitly listed ──────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
